---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import Lightbox from '../components/Lightbox.astro';
import { artworks } from '../data/art';

const items = await Promise.all(artworks.map(async (a) => ({ ...a, full: (await getImage({ src: a.src, width: 1800 })).src })));
---

<Base title="art" description="Drawings and pixel art by Milo Tekchandani, mostly made in Procreate.">
  <Tile label="art">
    <p class="sub lead">
      Procreate on an iPad, mostly. Concept sheets for a game, backgrounds for another, and maps I like drawn from
      memory.
    </p>
    <div class="masonry">
      {
        items.map((a) => (
          <figure>
            <a href={a.full} data-lightbox={a.caption}>
              <Image src={a.src} alt={a.alt} width={560} densities={[1, 2]} loading="lazy" />
            </a>
            <figcaption>{a.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </Tile>
  <Lightbox />
</Base>

<style>
  .masonry { columns: 3; column-gap: var(--gap); }
  .lead { max-width: 40rem; margin-bottom: 20px; }
  figure { margin: 0 0 var(--gap); break-inside: avoid; overflow: hidden; background: var(--base); }
  figure a { display: block; }
  figure img { width: 100%; transition: transform 0.2s; }
  figure:hover img { transform: scale(1.01); }
  figcaption { padding: 0.55rem 0.8rem 0.65rem; font-size: 0.9rem; color: var(--sub); }
  @media (max-width: 60rem) {
    .masonry { columns: 2; }
  }
  @media (max-width: 34rem) {
    .masonry { columns: 1; }
  }
</style>
