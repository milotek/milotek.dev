---
import {Image} from 'astro:assets';

import portraitArtwork from '../assets/art/3525b230.jpg';
import githubAvatar from '../assets/me/github.png';
import Buttons from '../components/Buttons.astro';
import GitHub from '../components/GitHub.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Tile from '../components/Tile.astro';
import {SITE, SOCIAL_LINKS} from '../config';
import {useTranslations} from '../i18n';
import Base from '../layouts/Base.astro';
import {getPosts} from '../lib/posts';
import {getProjects} from '../lib/projects';
import {formatIsoDate} from '../lib/time';
import {url} from '../lib/url';

const t = useTranslations(Astro.currentLocale);
const projects = await getProjects();
const posts = await getPosts();
const avatarImages = [portraitArtwork, githubAvatar];
---

<Base>
  <Tile
    label={t('home.about')}
    span={7}
    action={{href: url('about/'), text: t('home.more')}}
  >
    <div class="bio-layout">
      {
        avatarImages.map((src) => (
          <Image
            class="avatar"
            src={src}
            alt={t('home.portrait')}
            width={112}
            densities={[1, 2]}
            loading="lazy"
            hidden
          />
        ))
      }
      {/* Inline so a random avatar is revealed before first paint. */}
      <script is:inline>
        (() => {
          const avatars = document.querySelectorAll('.avatar');
          const chosen = avatars[Math.floor(Math.random() * avatars.length)];
          if (chosen instanceof HTMLImageElement) {
            chosen.hidden = false;
            chosen.loading = 'eager';
          }
        })();
      </script>
      <div>
        <h1 class="bio-name wide">{SITE.name}</h1>
        <p class="bio-role mono">{t('site.role')}</p>
        <p>{t('home.bio')}</p>
        <p set:html={t('home.bio.fursona')} />
      </div>
    </div>
  </Tile>

  <Tile label={t('home.nowPlaying')} span={5}>
    <NowPlaying />
  </Tile>

  <Tile
    label={t('home.projects')}
    action={{href: url('projects/'), text: t('home.more')}}
  >
    <div class="project-strip scroller">
      {projects.map((project) => <ProjectCard project={project} />)}
      <a class="all-projects-link button" href={url('projects/')}>
        {t('home.allProjects')}
      </a>
    </div>
  </Tile>

  <Tile label={t('home.contact')} span={4}>
    <ul class="social-links">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              class="button"
              href={social.href}
              style={`--brand: ${social.brandColor}; --ink: ${social.inkColor ?? 'var(--base)'}`}
            >
              {social.label.toLowerCase()}
              <span class="mono">{social.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile
    label={t('home.github')}
    span={8}
    action={{
      href: `https://github.com/${SITE.githubUsername}`,
      text: t('home.more'),
    }}
  >
    <GitHub />
  </Tile>

  <Tile
    label={t('home.blog')}
    span={8}
    action={{href: url('blog/'), text: t('home.more')}}
  >
    <ul class="post-list scroller">
      {
        posts.map((post) => (
          <li>
            <a href={url(`blog/${post.id}/`)}>
              <time class="mono dim" datetime={formatIsoDate(post.published)}>
                {formatIsoDate(post.published)}
              </time>
              {post.title}
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile label={t('home.buttons')} span={4}>
    <Buttons />
  </Tile>
</Base>

<style>
  .bio-layout {
    display: flex;
    gap: 18px;
  }

  .bio-layout img {
    flex: none;
    height: 112px;
    object-fit: cover;
    width: 112px;
  }

  .avatar[hidden] {
    display: none;
  }

  .bio-name {
    font-size: 28px;
    line-height: 1.1;
  }

  .bio-role {
    color: var(--pink);
    margin: 6px 0 12px;
  }

  .bio-layout p + p {
    margin-top: 8px;
  }

  .bio-layout p + p:last-child {
    margin-top: 1.55em;
  }

  .project-strip {
    --fade: 30%;
    --strip: bottom / 100% 6px;
    --towards: to right;
    display: grid;
    gap: 16px;
    grid-auto-columns: calc((100% - 48px) / 4);
    grid-auto-flow: column;
    margin-bottom: -10px;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .all-projects-link {
    display: grid;
    font-size: 16px;
    place-items: center;
    text-decoration: none;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .social-links a {
    display: flex;
    font-size: 16px;
    gap: 12px;
    justify-content: space-between;
    padding: 12px 14px;
    text-decoration: none;
  }

  .social-links span {
    color: var(--dim);
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s;
  }

  .social-links a:hover {
    background: var(--brand);
    color: var(--ink);
  }

  .social-links a:hover span {
    color: var(--ink);
  }

  .post-list {
    --fade: 48px;
    margin-right: -10px;
    overflow-y: auto;
    padding-right: 12px;
  }

  .post-list a {
    border-bottom: 1px solid var(--line);
    color: var(--text);
    display: flex;
    gap: 16px;
    padding: 10px 0;
    text-decoration: none;
  }

  .post-list li:last-child a {
    border: 0;
  }

  .post-list time {
    flex: none;
    padding-top: 2px;
  }

  .post-list a:hover {
    color: var(--pink);
  }

  @media (min-width: 901px) {
    :global(.tile:has(.post-list)) {
      contain: size;
      display: flex;
      flex-direction: column;
    }

    .post-list {
      flex: 1;
      min-height: 0;
    }
  }

  @media (max-width: 900px) {
    .post-list {
      max-height: 200px;
    }
  }

  @media (max-width: 600px) {
    .bio-layout {
      flex-direction: column;
    }

    .project-strip {
      grid-auto-columns: 75%;
    }

    .post-list a {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
