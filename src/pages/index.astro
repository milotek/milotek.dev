---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHub from '../components/GitHub.astro';
import Buttons from '../components/Buttons.astro';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { isoDate } from '../lib/time';
import { url } from '../lib/url';
import { site, socials } from '../config';
import me from '../assets/art/3525b230.jpg';

const featured = (await getProjects()).filter((p) => p.data.status).slice(0, 4);
const posts = (await getPosts()).slice(0, 4);
---

<Base>
  <Tile label="about" span={5}>
    <div class="who">
      <Image src={me} alt="A drawing of me" width={112} densities={[1, 2]} />
      <div>
        <h1 class="wide">{site.name}</h1>
        <p class="role mono">{site.role.toLowerCase()}</p>
        <p class="sub">19, from the UK. I work on the backend and infrastructure of the Google Search app for Android, right now on transitions between results tabs.</p>
        <p class="sub">Outside work: Linux and NixOS, the Source engine, Roblox (pre-slop), homelabbing. I also draw, cook and play drums.</p>
      </div>
    </div>
  </Tile>

  <Tile label="now playing" span={7} action={site.lastfm.user ? { href: `https://www.last.fm/user/${site.lastfm.user}`, text: 'last.fm ↗' } : undefined}>
    <NowPlaying />
  </Tile>

  <Tile label="things i've made" action={{ href: url('projects/'), text: 'all projects →' }}>
    <div class="projects">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </Tile>

  <Tile label="github" span={7} action={{ href: `https://github.com/${site.github}`, text: `@${site.github} ↗` }}>
    <GitHub />
  </Tile>

  <Tile label="contact" span={5}>
    <ul class="links">
      {
        socials.map((s) => (
          <li>
            <a href={s.href}>
              {s.label.toLowerCase()} <span class="mono">{s.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile label="blog" span={7} action={{ href: url('blog/'), text: 'every post →' }}>
    <ul class="posts">
      {
        posts.map((p) => (
          <li>
            <a href={url(`blog/${p.id}/`)}>
              <time class="mono dim" datetime={isoDate(p.published)}>{isoDate(p.published)}</time>
              {p.title}
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile label="buttons" span={5}>
    <Buttons />
  </Tile>
</Base>

<style>
  .who { display: flex; gap: 18px; }
  .who img { flex: none; width: 112px; height: 112px; object-fit: cover; }
  h1 { font-size: 28px; line-height: 1.1; }
  .role { color: var(--pink); margin: 6px 0 12px; }
  .who p + p { margin-top: 8px; }
  .projects { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .links { display: flex; flex-direction: column; gap: 10px; }
  .links a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    font-weight: 700;
    color: var(--text);
    background: var(--base);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .links span { color: var(--dim); overflow: hidden; text-overflow: ellipsis; }
  .links a:hover, .links a:hover span { color: var(--base); background: var(--pink); }
  .posts a { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .posts li:last-child a { border: 0; }
  .posts time { flex: none; padding-top: 2px; }
  .posts a:hover { color: var(--pink); }
  @media (max-width: 900px) {
    .projects { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .who { flex-direction: column; }
    .projects { grid-template-columns: 1fr; }
    .posts a { flex-direction: column; gap: 2px; }
  }
</style>
