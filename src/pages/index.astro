---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import NowPlaying from '../components/NowPlaying.astro';
import GitHub from '../components/GitHub.astro';
import Buttons from '../components/Buttons.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { isoDate } from '../lib/time';
import { url } from '../lib/url';
import { site, socials } from '../config';
import { useTranslations } from '../i18n';
import me from '../assets/art/3525b230.jpg';
import github from '../assets/me/github.png';

const t = useTranslations(Astro.currentLocale);
const projects = await getProjects();
const posts = await getPosts();
---

<Base>
  <Tile label={t('home.about')} span={7} action={{ href: url('about/'), text: t('home.more') }}>
    <div class="who">
      {[me, github].map((src) => <Image class="pfp" src={src} alt={t('home.portrait')} width={112} densities={[1, 2]} loading="lazy" hidden />)}
      <div>
        <h1 class="wide">{site.name}</h1>
        <p class="role mono">{t('site.role')}</p>
        <p>{t('home.bio')}</p>
        <p set:html={t('home.bio.fursona')} />
      </div>
    </div>
  </Tile>

  <Tile label={t('home.nowPlaying')} span={5}>
    <NowPlaying />
  </Tile>

  <Tile label={t('home.projects')} action={{ href: url('projects/'), text: t('home.more') }}>
    <div class="projects scroller">
      {projects.map((p) => <ProjectCard project={p} />)}
      <a class="more button" href={url('projects/')}>{t('home.allProjects')}</a>
    </div>
  </Tile>

  <Tile label={t('home.contact')} span={4}>
    <ul class="links">
      {
        socials.map((s) => (
          <li>
            <a class="button" href={s.href} style={`--brand: ${s.colour}; --ink: ${s.ink ?? 'var(--base)'}`}>
              {s.label.toLowerCase()} <span class="mono">{s.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile label={t('home.github')} span={8} action={{ href: `https://github.com/${site.github}`, text: t('home.more') }}>
    <GitHub />
  </Tile>

  <Tile label={t('home.blog')} span={8} action={{ href: url('blog/'), text: t('home.more') }}>
    <ul class="posts scroller">
      {
        posts.map((p) => (
          <li>
            <a href={url(`blog/${p.id}/`)}>
              <time class="mono dim" datetime={isoDate(p.published)}>{isoDate(p.published)}</time>
              {p.title}
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile label={t('home.buttons')} span={4}>
    <Buttons />
  </Tile>
</Base>

<script>
  const pfps = document.querySelectorAll<HTMLImageElement>('.pfp');
  pfps[Math.floor(Math.random() * pfps.length)]!.hidden = false;
</script>

<style>
  .who { display: flex; gap: 18px; }
  .who img { flex: none; width: 112px; height: 112px; object-fit: cover; }
  .pfp[hidden] { display: none; }
  h1 { font-size: 28px; line-height: 1.1; }
  .role { color: var(--pink); margin: 6px 0 12px; }
  .who p + p { margin-top: 8px; }
  .who p + p:last-child { margin-top: 1.55em; }
  .projects {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 48px) / 4);
    gap: 16px;
    margin-bottom: -10px;
    padding-bottom: 12px;
    overflow-x: auto;
    --fade: 30%;
    --strip: bottom / 100% 12px;
    --towards: to right;
  }
  .more { display: grid; place-items: center; font-size: 16px; text-decoration: none; }
  .links { display: flex; flex-direction: column; gap: 10px; }
  .links a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 14px; font-size: 16px; text-decoration: none; }
  .links span { color: var(--dim); overflow: hidden; text-overflow: ellipsis; transition: color 0.25s; }
  .links a:hover { color: var(--ink); background: var(--brand); }
  .links a:hover span { color: var(--ink); }
  .posts a { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .posts li:last-child a { border: 0; }
  .posts { margin-right: -10px; padding-right: 12px; overflow-y: auto; --fade: 48px; }
  @media (min-width: 901px) {
    :global(.tile:has(.posts)) { contain: size; display: flex; flex-direction: column; }
    .posts { flex: 1; min-height: 0; }
  }
  .posts time { flex: none; padding-top: 2px; }
  .posts a:hover { color: var(--pink); }
  @media (max-width: 900px) {
    .posts { max-height: 200px; }
  }
  @media (max-width: 600px) {
    .who { flex-direction: column; }
    .projects { grid-auto-columns: 75%; }
    .posts a { flex-direction: column; gap: 2px; }
  }
</style>
