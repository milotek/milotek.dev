---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
const projects = await getProjects();
---

<Base title={t('projects.title')} description={t('projects.description')}>
  <Tile label={t('projects.title')}>
    <div class="cards">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </Tile>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 20px; }
</style>
