---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base title="projects" description="Things Milo Tekchandani has built: backend and infrastructure, hardware, apps, games.">
  <Tile label="projects">
    <div class="cards">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </Tile>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 20px; }
</style>
