---
import {Image} from 'astro:assets';
import {getCollection, render, type CollectionEntry} from 'astro:content';

import Tile from '../../components/Tile.astro';
import {useTranslations} from '../../i18n';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: {slug: project.id},
    props: {project},
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const {project} = Astro.props;
const {Content} = await render(project);
const {title, blurb, year, by, tech, links, images} = project.data;
const t = useTranslations(Astro.currentLocale);
---

<Base title={title} description={blurb} type="article">
  <Tile label={t('project.label')} span={8}>
    <article class="prose">
      <h1>{title}</h1>
      <p class="project-blurb">{blurb}</p>
      <Content />
      {
        images.map((image) => (
          <Image
            src={image.src}
            alt={image.alt}
            width={1200}
            densities={[1, 2]}
            loading="lazy"
          />
        ))
      }
    </article>
  </Tile>

  <Tile label={t('project.details')} span={4}>
    <dl>
      <dt class="mono dim">{t('project.by')}</dt>
      <dd>{by}</dd>
      <dt class="mono dim">{t('project.year')}</dt>
      <dd>{year}</dd>
      <dt class="mono dim">{t('project.tech')}</dt>
      <dd>{tech.join(', ')}</dd>
    </dl>
    {
      links.length > 0 && (
        <ul class="project-links">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label} ↗</a>
            </li>
          ))}
        </ul>
      )
    }
  </Tile>
</Base>

<style>
  .project-blurb {
    color: var(--text);
    font-size: 1.15rem;
  }

  dd + dt {
    margin-top: 10px;
  }

  .project-links {
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 18px;
    padding-top: 14px;
  }
</style>
