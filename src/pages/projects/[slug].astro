---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, blurb, year, by, tech, links, images } = project.data;
---

<Base title={title} description={blurb} type="article">
  <Tile label="project" span={8}>
    <article class="prose">
      <h1>{title}</h1>
      <p class="blurb">{blurb}</p>
      <Content />
      {images.map((img) => <Image src={img.src} alt={img.alt} width={1200} densities={[1, 2]} loading="lazy" />)}
    </article>
  </Tile>

  <Tile label="details" span={4}>
    <dl>
      <dt class="mono dim">by</dt>
      <dd>{by}</dd>
      <dt class="mono dim">year</dt>
      <dd>{year}</dd>
      <dt class="mono dim">made with</dt>
      <dd>{tech.join(', ')}</dd>
    </dl>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label} ↗</a>
            </li>
          ))}
        </ul>
      )
    }
  </Tile>
</Base>

<style>
  .blurb { color: var(--text); font-size: 1.15rem; }
  dd + dt { margin-top: 10px; }
  .links { display: flex; flex-direction: column; gap: 6px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); }
</style>
