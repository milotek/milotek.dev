---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, blurb, status, year, tech, links, images } = project.data;
const gallery = await Promise.all(images.map(async (img) => ({ ...img, full: (await getImage({ src: img.src, width: 1600 })).src })));
---

<Base title={title} description={blurb} type="article">
  <Tile label="project" span={8}>
    <article class="prose">
      <h1>{title}</h1>
      <p class="blurb">{blurb}</p>
      <Content />
    </article>
    {
      gallery.length > 0 && (
        <div class="gallery" aria-label="Screenshots">
          {gallery.map((img) => (
            <a href={img.full} data-lightbox={img.alt}>
              <Image src={img.src} alt={img.alt} width={720} densities={[1, 2]} loading="lazy" />
            </a>
          ))}
        </div>
      )
    }
  </Tile>

  <Tile label="details" span={4}>
    <dl>
      <dt class="mono dim">status</dt>
      <dd>{status}</dd>
      <dt class="mono dim">year</dt>
      <dd>{year}</dd>
      <dt class="mono dim">made with</dt>
      <dd>{tech.join(', ')}</dd>
    </dl>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label} ↗</a>
            </li>
          ))}
        </ul>
      )
    }
  </Tile>

  <Lightbox />
</Base>

<style>
  .blurb { color: var(--text); font-size: 1.15rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 12px; margin-top: 2rem; }
  .gallery a { display: block; overflow: hidden; background: var(--crust); }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.2s; }
  .gallery a:hover img { transform: scale(1.03); }
  dl { display: grid; gap: 2px 0; }
  dd + dt { margin-top: 10px; }
  .links { display: flex; flex-direction: column; gap: 6px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); }
</style>
