---
import {Image} from 'astro:assets';

import Tile from '../../components/Tile.astro';
import {ARTWORKS} from '../../data/art';
import {useTranslations} from '../../i18n';
import Base from '../../layouts/Base.astro';
import {url} from '../../lib/url';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t('art.title')} description={t('art.description')}>
  <Tile label={t('art.title')}>
    <div class="art-masonry">
      {
        ARTWORKS.map((artwork) => (
          <a href={url(`art/${artwork.slug}/`)}>
            <Image
              src={artwork.src}
              alt={artwork.caption}
              width={560}
              densities={[1, 2]}
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </Tile>
</Base>

<style>
  .art-masonry {
    column-gap: var(--gap);
    columns: 3;
  }

  a {
    break-inside: avoid;
    display: block;
    margin-bottom: var(--gap);
    overflow: hidden;
  }

  img {
    width: 100%;
  }

  @media (max-width: 900px) {
    .art-masonry {
      columns: 2;
    }
  }

  @media (max-width: 600px) {
    .art-masonry {
      columns: 1;
    }
  }
</style>
