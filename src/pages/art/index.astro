---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { artworks } from '../../data/art';
import { useTranslations } from '../../i18n';
import { url } from '../../lib/url';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t('art.title')} description={t('art.description')}>
  <Tile label={t('art.title')}>
    <div class="masonry">
      {
        artworks.map((a) => (
          <a href={url(`art/${a.slug}/`)}>
            <Image src={a.src} alt={a.caption} width={560} densities={[1, 2]} loading="lazy" />
          </a>
        ))
      }
    </div>
  </Tile>
</Base>

<style>
  .masonry { columns: 3; column-gap: var(--gap); }
  a { display: block; margin-bottom: var(--gap); overflow: hidden; break-inside: avoid; }
  img { width: 100%; transition: transform 0.3s; }
  a:hover img { transform: scale(1.05); }
  @media (max-width: 900px) {
    .masonry { columns: 2; }
  }
  @media (max-width: 600px) {
    .masonry { columns: 1; }
  }
</style>
