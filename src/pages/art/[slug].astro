---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { artworks, type Artwork } from '../../data/art';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return artworks.map((art) => ({ params: { slug: art.slug }, props: { art } }));
}

const { art } = Astro.props as { art: Artwork };
---

<Base title={art.title} description={art.caption} type="article">
  <Tile label="art" action={{ href: url('art/'), text: '← all art' }}>
    <article class="prose">
      <h1>{art.title}</h1>
      <p>{art.caption}</p>
      <Image src={art.src} alt={art.caption} width={1400} densities={[1, 2]} />
    </article>
  </Tile>
</Base>

<style>
  article { max-width: 56rem; margin-inline: auto; }
</style>
