---
import {Image} from 'astro:assets';

import Tile from '../../components/Tile.astro';
import {ARTWORKS, type Artwork} from '../../data/art';
import {useTranslations} from '../../i18n';
import Base from '../../layouts/Base.astro';
import {url} from '../../lib/url';

export function getStaticPaths() {
  return ARTWORKS.map((artwork) => ({
    params: {slug: artwork.slug},
    props: {artwork},
  }));
}

interface Props {
  artwork: Artwork;
}

const {artwork} = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<Base title={artwork.title} description={artwork.caption} type="article">
  <Tile
    label={t('art.title')}
    action={{href: url('art/'), text: t('art.back')}}
  >
    <article class="artwork-detail prose">
      <h1>{artwork.title}</h1>
      <p>{artwork.caption}</p>
      <Image
        src={artwork.src}
        alt={artwork.caption}
        width={1400}
        densities={[1, 2]}
      />
    </article>
  </Tile>
</Base>

<style>
  .artwork-detail {
    margin-inline: auto;
    max-width: 56rem;
  }
</style>
