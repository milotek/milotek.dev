---
import {render} from 'astro:content';

import Tile from '../../components/Tile.astro';
import {useTranslations} from '../../i18n';
import Base from '../../layouts/Base.astro';
import {getPosts, type BlogPost} from '../../lib/posts';
import {formatIsoDate, formatLongDate} from '../../lib/time';
import {url} from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: {slug: post.id},
    props: {post},
  }));
}

interface Props {
  post: BlogPost;
}

const {post} = Astro.props;
const {Content} = await render(post.entry);
const t = useTranslations(Astro.currentLocale);
---

<Base title={post.title} description={post.title} type="article">
  <Tile
    label={t('blog.title')}
    action={{href: url('blog/'), text: t('blog.back')}}
  >
    <article class="blog-article prose">
      <time
        class="publish-date mono dim"
        datetime={formatIsoDate(post.published)}
      >
        {formatLongDate(post.published, t('lang'))}
      </time>
      <Content />
    </article>
  </Tile>
</Base>

<style>
  .blog-article {
    margin-inline: auto;
    max-width: 46rem;
    padding-bottom: 2.5rem;
  }

  .publish-date {
    display: block;
  }
</style>
