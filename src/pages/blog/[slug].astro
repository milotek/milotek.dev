---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { getPosts } from '../../lib/posts';
import { isoDate, longDate } from '../../lib/time';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post.entry);
---

<Base title={post.title} description={post.title} type="article">
  <Tile label="blog" action={{ href: url('blog/'), text: '← every post' }}>
    <article class="prose">
      <time class="mono dim" datetime={isoDate(post.published)}>{longDate(post.published)}</time>
      <Content />
    </article>
  </Tile>
</Base>

<style>
  article { max-width: 46rem; margin-inline: auto; }
  time { display: block; }
</style>
