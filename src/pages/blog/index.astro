---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { getPosts } from '../../lib/posts';
import { isoDate } from '../../lib/time';
import { url } from '../../lib/url';

const posts = await getPosts();
---

<Base title="blog" description="Writing by Milo Tekchandani. Keyboards, VR headsets, Lua, whatever else.">
  <Tile label="blog" action={{ href: url('rss.xml'), text: 'rss ↗' }}>
    <p class="sub lead">Opinions, mostly about hardware and software that annoyed me.</p>
    <ul class="posts">
      {
        posts.map((p) => (
          <li>
            <a href={url(`blog/${p.id}/`)}>
              <time class="mono dim" datetime={isoDate(p.published)}>{isoDate(p.published)}</time>
              <span class="wide">{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>
</Base>

<style>
  .lead { margin-bottom: 12px; }
  .posts a { display: flex; gap: 20px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .posts li:last-child a { border: 0; }
  .posts time { flex: none; }
  .posts span { font-size: 1.1rem; }
  .posts a:hover { color: var(--pink); }
  @media (max-width: 600px) {
    .posts a { flex-direction: column; gap: 4px; }
  }
</style>
