---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { url } from '../lib/url';
---

<Base title="404" description="Not here.">
  <Tile label="404">
    <div class="lost">
      <img src={url('under_construction.gif')} alt="A badly drawn stick figure giving a thumbs up next to two cogs, captioned UNDER CONSTRUCTION." width="480" height="360" />
      <a class="chip" href={url('')}>back home</a>
    </div>
  </Tile>
</Base>

<style>
  .lost { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
</style>
