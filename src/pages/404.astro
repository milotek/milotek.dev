---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { useTranslations } from '../i18n';
import { url } from '../lib/url';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t('404.title')} description={t('404.description')}>
  <Tile label={t('404.title')}>
    <div class="lost">
      <img src={url('under_construction.gif')} alt={t('404.image')} width="480" height="360" />
      <a class="chip" href={url('')}>{t('404.home')}</a>
    </div>
  </Tile>
</Base>

<style>
  .lost { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
</style>
