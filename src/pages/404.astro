---
import Tile from '../components/Tile.astro';
import {useTranslations} from '../i18n';
import Base from '../layouts/Base.astro';
import {url} from '../lib/url';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t('404.title')} description={t('404.description')}>
  <Tile label={t('404.title')}>
    <div class="not-found">
      <img
        src={url('under_construction.gif')}
        alt={t('404.image')}
        width="480"
        height="360"
      />
      <div class="not-found-text" set:html={t('404.body', {contact: url('#contact')})} />
      <a class="chip" href={url('')}>{t('404.home')}</a>
    </div>
    <script is:inline>
      document.querySelector('.wayback').href =
        `https://web.archive.org/web/*/${location.href}`;
    </script>
  </Tile>
</Base>

<style>
  .not-found {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .not-found-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 60ch;
  }
</style>
