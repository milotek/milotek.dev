---
import '../styles/global.css';
import { site } from '../config';
import { url } from '../lib/url';
import Marquee from '../components/Marquee.astro';
import Hero from '../components/Hero.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.handle}` : `${site.name} · ${site.handle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = Astro.url.pathname === url('');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.handle} blog`} href={url('rss.xml')} />
    <link rel="preload" href={url('fonts/sans.otf')} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={url('fonts/extended.otf')} as="font" type="font/otf" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.handle} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Marquee />
    <div class="page">
      <Hero compact={!home} />
      <main class="grid">
        <slot />
      </main>
      <footer class="mono dim">
        <span>{site.name}</span>
        <a href={url('rss.xml')}>rss</a>
        <span>built {new Date().toISOString().slice(0, 10)}</span>
      </footer>
    </div>
  </body>
</html>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 28px;
  }
  footer > * {
    padding: 4px 8px;
    background: var(--mantle);
  }
  footer a { color: var(--dim); }
  footer a:hover { color: var(--pink); }
</style>
