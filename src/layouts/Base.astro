---
import '../styles/global.css';

import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import {SITE} from '../config';
import {useTranslations} from '../i18n';
import {getLatestCommitStamp} from '../lib/git';
import {url} from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const t = useTranslations(Astro.currentLocale);
const {
  title,
  description = t('site.description'),
  type = 'website',
} = Astro.props;

const fullTitle = title
  ? `${title} · ${SITE.handle}`
  : `${SITE.name} · ${SITE.handle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const commitStamp = getLatestCommitStamp();
---

<!doctype html>
<html lang={t('lang')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('rss.title', {handle: SITE.handle})}
      href={url('rss.xml')}
    />
    <link
      rel="preload"
      href={url('fonts/sans.otf')}
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href={url('fonts/extended.otf')}
      as="font"
      type="font/otf"
      crossorigin
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.handle} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Marquee />
    <div class="page">
      <Hero />
      <main class="grid">
        <slot />
      </main>
      <footer class="site-footer mono dim">
        <a href={SITE.repoUrl}>{t('footer.source')}</a>
        <a href={`${SITE.repoUrl}/commit/${commitStamp.shortHash}`}>
          {commitStamp.label}
        </a>
      </footer>
    </div>

    <script>
      import {initUiEffects} from '../scripts/ui_effects';

      initUiEffects();
      if (new URLSearchParams(location.search).has('edit')) {
        import('../scripts/edit_strings').then((m) => m.initEditStrings());
      }
    </script>
  </body>
</html>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 28px;
  }

  .site-footer > * {
    background: var(--mantle);
    padding: 4px 8px;
  }

  .site-footer a {
    color: var(--dim);
  }

  .site-footer a:hover {
    color: var(--pink);
  }
</style>
