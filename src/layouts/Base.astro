---
import '../styles/global.css';
import { site } from '../config';
import { url } from '../lib/url';
import Bar from '../components/Bar.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.handle}` : `${site.name} · ${site.handle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#11111b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.handle} blog`} href={url('rss.xml')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.handle} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Bar />
    <main class="workspace" id="main">
      <slot />
    </main>
    <footer class="foot">
      <span>{site.name}</span>
      <span class="foot__sep">/</span>
      <a href={url('rss.xml')}>rss</a>
      <span class="foot__sep">/</span>
      <a href="https://astro.build">astro</a>
      <span class="foot__sep">/</span>
      <a href="https://catppuccin.com">catppuccin mocha</a>
      <span class="foot__sep">/</span>
      <span>built {new Date().toISOString().slice(0, 10)}</span>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 10;
    background: var(--accent); color: var(--crust); padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); text-decoration: none;
  }
  .skip:focus { top: 1rem; }
</style>
