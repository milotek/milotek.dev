---
// One dialog per page; any <a data-lightbox href="full.jpg"><img></a> opens in it.
// Esc and a click outside close it, both free from <dialog>.
---

<dialog class="lightbox" aria-label="Image viewer">
  <img alt="" />
  <p class="caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('.caption')!;

  document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      caption.textContent = a.dataset.lightbox ?? '';
      dialog.showModal();
    }),
  );
  dialog.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => img.removeAttribute('src'));
</script>

<style>
  .lightbox { border: 0; padding: 0; background: transparent; overflow: hidden; max-width: min(96vw, 1400px); max-height: 96vh; }
  .lightbox::backdrop { background: rgb(17 17 27 / 0.9); }
  .lightbox img { max-height: 88vh; width: auto; margin: 0 auto; border-radius: var(--radius-sm); }
  .caption { text-align: center; color: var(--subtext1); margin-top: 0.6rem; font-size: 0.95rem; }
  .caption:empty { display: none; }
</style>
