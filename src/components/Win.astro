---
interface Props {
  title: string;
  span?: 'half' | 'third' | 'twothirds';
  meta?: string;
  side?: boolean;
  read?: boolean;
  id?: string;
}

const { title, span, meta, side, read, id } = Astro.props;
const classes = ['win', span && `win--${span}`, side && 'win--side', read && 'win--read'].filter(Boolean).join(' ');
---

<section class={classes} id={id}>
  <div class="win__bar">
    <span class="win__dot" aria-hidden="true"></span>
    <h2 class="win__title">{title}</h2>
    {meta && <span class="win__meta">{meta}</span>}
  </div>
  <div class="win__body">
    <slot />
  </div>
</section>
