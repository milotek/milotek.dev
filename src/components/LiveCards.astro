---
import { site } from '../config';

const lastfmReady = Boolean(site.lastfm.user && site.lastfm.apiKey);
---

<div class="live">
  <section class="card listening" aria-labelledby="listening-h" data-user={site.lastfm.user} data-key={site.lastfm.apiKey}>
    <h3 id="listening-h" class="mono muted">listening</h3>
    <div class="row">
      <div class="art" aria-hidden="true" hidden={!lastfmReady}></div>
      <div class="meta">
        <p class="track">
          {lastfmReady ? 'checking…' : <a href={site.spotify}>Spotify profile</a>}
        </p>
        <p class="sub muted">{lastfmReady ? ' ' : 'Last.fm is not wired up yet.'}</p>
      </div>
    </div>
  </section>

  <section class="card github" aria-labelledby="github-h" data-user={site.github}>
    <h3 id="github-h" class="mono muted">github</h3>
    <ul class="events">
      <li class="muted">
        loading… (or <a href={`https://github.com/${site.github}`}>go there</a>)
      </li>
    </ul>
  </section>
</div>

<script>
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]>) {
    return Object.assign(document.createElement(tag), props);
  }

  // Each step divides into the unit it is labelled with, so the label is always
  // the unit the running total is now counted in.
  const UNITS: [number, string][] = [[60, 'm'], [60, 'h'], [24, 'd'], [7, 'w'], [4.35, 'mo'], [12, 'y']];

  function ago(when: string | number): string {
    let n = Math.max(1, Math.round((Date.now() - new Date(when).getTime()) / 1000));
    let label = 's';
    for (const [div, next] of UNITS) {
      if (n < div) break;
      n /= div;
      label = next;
    }
    return `${Math.round(n)}${label} ago`;
  }

  async function lastfm() {
    const card = document.querySelector<HTMLElement>('.listening');
    if (!card?.dataset.user || !card.dataset.key) return;
    const track = card.querySelector<HTMLElement>('.track')!;
    const sub = card.querySelector<HTMLElement>('.sub')!;
    const art = card.querySelector<HTMLElement>('.art')!;
    try {
      const params = new URLSearchParams({
        method: 'user.getrecenttracks',
        user: card.dataset.user,
        api_key: card.dataset.key,
        format: 'json',
        limit: '1',
      });
      const res = await fetch(`https://ws.audioscrobbler.com/2.0/?${params}`);
      if (!res.ok) throw new Error(String(res.status));
      const t = (await res.json())?.recenttracks?.track?.[0];
      if (!t) throw new Error('empty');
      const live = t['@attr']?.nowplaying === 'true';
      track.replaceChildren(el('a', { href: t.url, textContent: t.name }));
      sub.textContent = `${t.artist['#text']} · ${live ? 'now playing' : ago(Number(t.date.uts) * 1000)}`;
      const img = t.image?.find((i: { size: string }) => i.size === 'large')?.['#text'];
      if (img) {
        art.style.backgroundImage = `url("${img}")`;
        art.classList.add('has-art');
      }
      if (live) card.classList.add('live-now');
    } catch {
      track.textContent = 'quiet for now';
      sub.textContent = 'Last.fm did not answer.';
    }
  }

  interface GhEvent {
    type: string;
    created_at: string;
    repo: { name: string };
    payload: {
      action?: string;
      ref_type?: string;
      ref?: string;
      pull_request?: { number: number; title: string; html_url: string };
      issue?: { number: number; html_url: string };
      release?: { tag_name: string; html_url: string };
    };
  }

  function describe(e: GhEvent): { text: string; href: string } | undefined {
    const repo = `https://github.com/${e.repo.name}`;
    const { action, ref, ref_type, pull_request: pr, issue, release } = e.payload;
    switch (e.type) {
      case 'PushEvent': {
        // The public events API no longer includes the commit count.
        const branch = ref?.replace('refs/heads/', '');
        return { text: `pushed to ${e.repo.name}${branch && branch !== 'main' ? ` (${branch})` : ''}`, href: repo };
      }
      case 'PullRequestEvent':
        return { text: `${action} PR #${pr!.number} in ${e.repo.name}`, href: pr!.html_url };
      case 'IssuesEvent':
        return { text: `${action} an issue in ${e.repo.name}`, href: issue!.html_url };
      case 'CreateEvent':
        return ref_type === 'repository'
          ? { text: `created ${e.repo.name}`, href: repo }
          : { text: `created ${ref_type} ${ref} in ${e.repo.name}`, href: repo };
      case 'ReleaseEvent':
        return { text: `released ${release!.tag_name} of ${e.repo.name}`, href: release!.html_url };
      case 'WatchEvent':
        return { text: `starred ${e.repo.name}`, href: repo };
      case 'ForkEvent':
        return { text: `forked ${e.repo.name}`, href: repo };
      default:
        return undefined;
    }
  }

  async function github() {
    const card = document.querySelector<HTMLElement>('.github');
    if (!card?.dataset.user) return;
    const list = card.querySelector<HTMLElement>('.events')!;
    try {
      const res = await fetch(`https://api.github.com/users/${card.dataset.user}/events/public?per_page=30`);
      if (!res.ok) throw new Error(String(res.status));
      const events = (await res.json()) as GhEvent[];
      const items = events.map((e) => ({ when: e.created_at, ...describe(e) })).filter((i) => i.text).slice(0, 4);
      if (!items.length) throw new Error('empty');
      list.replaceChildren(
        ...items.map((i) => {
          const li = document.createElement('li');
          li.append(
            el('a', { href: i.href!, textContent: i.text! }),
            el('span', { className: 'when', textContent: ago(i.when) }),
          );
          return li;
        }),
      );
    } catch {
      const li = el('li', { className: 'muted' });
      li.innerHTML = `GitHub is rate limiting. <a href="https://github.com/${card.dataset.user}">Go there instead.</a>`;
      list.replaceChildren(li);
    }
  }

  lastfm();
  github();
</script>

<style>
  .live {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  h3 { font-family: var(--font-mono); font-weight: 500; font-size: 0.8rem; margin-bottom: 0.7rem; }
  h3::before { content: '● '; color: var(--surface2); }
  .live-now h3::before { color: var(--green); }
  .row { display: flex; gap: 0.9rem; align-items: center; }
  .art {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface0) center / cover no-repeat;
    border: 1px solid var(--surface1);
  }
  .art[hidden] { display: none; }
  .meta { min-width: 0; }
  .track, .sub, .events :global(a) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .track { font-weight: 600; }
  .sub { font-size: 0.9rem; }
  .events {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.95rem;
  }
  .events > :global(li) { display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline; }
  .events :global(.when) { flex: none; font-family: var(--font-mono); font-size: 0.75rem; color: var(--overlay1); }
</style>
