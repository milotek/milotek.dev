---
import { site } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

interface Day {
  date: string;
  contributionLevel: 'NONE' | 'FIRST_QUARTILE' | 'SECOND_QUARTILE' | 'THIRD_QUARTILE' | 'FOURTH_QUARTILE';
}

interface Profile {
  repositories: { totalCount: number };
  recent: { nodes: { name: string; description: string | null; url: string }[] };
  contributionsCollection: { contributionCalendar: { totalContributions: number; weeks: { contributionDays: Day[] }[] } };
}

const QUERY = `query($login: String!) {
  user(login: $login) {
    repositories(privacy: PUBLIC, ownerAffiliations: OWNER) { totalCount }
    recent: repositories(first: 2, privacy: PUBLIC, ownerAffiliations: OWNER, orderBy: { field: PUSHED_AT, direction: DESC }) {
      nodes { name description url }
    }
    contributionsCollection { contributionCalendar { totalContributions weeks { contributionDays { date contributionLevel } } } }
  }
}`;

async function fetchProfile(): Promise<Profile | undefined> {
  const token = process.env.GITHUB_TOKEN;
  if (!token) return undefined;
  const res = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: { authorization: `bearer ${token}`, 'content-type': 'application/json' },
    body: JSON.stringify({ query: QUERY, variables: { login: site.github } }),
  });
  if (!res.ok) throw new Error(`GitHub GraphQL ${res.status}`);
  const { data, errors } = await res.json();
  if (errors) throw new Error(`GitHub GraphQL: ${errors[0].message}`);
  return data.user;
}

const LEVEL = { NONE: 0, FIRST_QUARTILE: 1, SECOND_QUARTILE: 2, THIRD_QUARTILE: 3, FOURTH_QUARTILE: 4 };

const profile = await fetchProfile().catch((error) => {
  console.warn(`GitHub tile falls back to a link: ${error.message}`);
  return undefined;
});
const calendar = profile?.contributionsCollection.contributionCalendar;
const weeks = calendar?.weeks.slice(-40) ?? [];
---

{
  profile && calendar ? (
    <>
      <p class="numbers mono dim">
        {t('github.summary', { contributions: calendar.totalContributions.toLocaleString(t('lang')), repos: profile.repositories.totalCount })}
      </p>
      <div class="calendar" style={`--weeks: ${weeks.length}; --days: ${weeks.at(-1)?.contributionDays.length ?? 7}`} aria-hidden="true">
        {weeks.flatMap((w) => w.contributionDays.map((d) => <i class={`l${LEVEL[d.contributionLevel]}`} />))}
      </div>
      <ul class="repos">
        {profile.recent.nodes.map((r) => (
          <li>
            <a href={r.url}>
              <b class="mono">{r.name}</b>
              {r.description && <span class="sub">{r.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <a href={`https://github.com/${site.github}`}>github.com/{site.github}</a>
  )
}

<style>
  /* One rainbow behind the whole grid, like the 3D graph on the GitHub profile.
     The mask keeps only the cells (columns ∩ rows ∩ not the unfilled end of this
     week); each cell then darkens the rainbow by contribution level. */
  .calendar {
    --cell-gap: 3px;
    --col: calc((100% + var(--cell-gap)) / var(--weeks));
    --row: calc((100% + var(--cell-gap)) / 7);
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-template-columns: repeat(var(--weeks), 1fr);
    grid-auto-flow: column;
    gap: var(--cell-gap);
    margin: 14px 0;
    background: var(--rainbow);
    animation: rainbow 10s linear infinite reverse;
    mask:
      linear-gradient(90deg, #000 calc(100% - var(--cell-gap)), #0000 0) 0 0 / var(--col) 100%,
      linear-gradient(#000 calc(100% - var(--cell-gap)), #0000 0) 0 0 / 100% var(--row),
      linear-gradient(90deg, #000 calc(100% - var(--col)), #0000 0),
      linear-gradient(#000 calc(var(--row) * var(--days)), #0000 0);
    mask-composite: intersect, intersect, add;
  }
  .calendar i { aspect-ratio: 1; }
  .calendar .l0 { background: color-mix(in srgb, var(--base) 75%, transparent); }
  .calendar .l1 { background: color-mix(in srgb, var(--base) 45%, transparent); }
  .calendar .l2 { background: color-mix(in srgb, var(--base) 30%, transparent); }
  .calendar .l3 { background: color-mix(in srgb, var(--base) 15%, transparent); }
  .repos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .repos a { display: block; height: 100%; padding: 10px 12px; background: var(--base); text-decoration: none; }
  .repos a:hover { outline: 1px solid var(--pink); }
  .repos span { display: block; margin-top: 4px; font-size: 13px; }
  @media (max-width: 600px) {
    .repos { grid-template-columns: 1fr; }
  }
</style>
