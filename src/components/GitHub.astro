---
import {SITE} from '../config';
import {useTranslations} from '../i18n';
import {
  CONTRIBUTION_LEVEL_INDEX,
  fetchGitHubProfile,
} from '../lib/github';
import {formatLongDate} from '../lib/time';

const t = useTranslations(Astro.currentLocale);
const locale = t('lang');

const VISIBLE_WEEK_COUNT = 40;
const STAR_ICON_PATH =
  'M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z';
const FORK_ICON_PATH =
  'M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z';

function formatCompactCount(count: number): string {
  return count.toLocaleString(locale, {notation: 'compact'});
}

const profile = await fetchGitHubProfile(SITE.githubUsername);
const calendar = profile?.contributionsCollection.contributionCalendar;
const weeks = calendar?.weeks.slice(-VISIBLE_WEEK_COUNT) ?? [];
---

{
  profile && calendar ? (
    <>
      <p class="mono dim">
        {t('github.summary', {
          contributions: calendar.totalContributions.toLocaleString(locale),
          repos: profile.repositories.totalCount,
        })}
      </p>

      <div
        class="contribution-calendar"
        style={`--weeks: ${weeks.length}`}
        aria-hidden="true"
      >
        {weeks.flatMap((week, weekIndex) =>
          week.contributionDays.map((day, dayIndex) => {
            const level = CONTRIBUTION_LEVEL_INDEX[day.contributionLevel];
            const tooltip = t(
              day.contributionCount === 1 ? 'github.dayOne' : 'github.day',
              {
                count: day.contributionCount,
                date: formatLongDate(new Date(day.date), locale),
              },
            );
            return (
              <i
                class={`contribution-level-${level}`}
                style={`--delay-step: ${weekIndex + dayIndex}`}
                title={tooltip}
              />
            );
          }),
        )}
      </div>

      <ul class="github-repos">
        {profile.pinnedItems.nodes.map((repo) => (
          <li>
            <a class="card" href={repo.url}>
              <b class="mono">{repo.name}</b>
              {repo.description && <span class="sub">{repo.description}</span>}
              <span class="repo-stats mono dim">
                {repo.primaryLanguage && (
                  <span>
                    <i
                      style={`--lang-color: ${repo.primaryLanguage.color ?? 'var(--dim)'}`}
                    />
                    {repo.primaryLanguage.name}
                  </span>
                )}
                {repo.stargazerCount > 0 && (
                  <span>
                    <svg
                      viewBox="0 0 16 16"
                      role="img"
                      aria-label={t('github.stars')}
                    >
                      <path d={STAR_ICON_PATH} />
                    </svg>
                    {formatCompactCount(repo.stargazerCount)}
                  </span>
                )}
                {repo.forkCount > 0 && (
                  <span>
                    <svg
                      viewBox="0 0 16 16"
                      role="img"
                      aria-label={t('github.forks')}
                    >
                      <path d={FORK_ICON_PATH} />
                    </svg>
                    {formatCompactCount(repo.forkCount)}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="error-banner">
      <span>
        <span>{t('error.broke', {what: 'github'})}</span>
      </span>
    </p>
  )
}

<style>
  .contribution-calendar {
    display: grid;
    gap: 3px;
    grid-auto-flow: column;
    grid-template-columns: repeat(var(--weeks), 1fr);
    grid-template-rows: repeat(7, 1fr);
    margin: 14px 0;
  }

  .contribution-calendar i {
    animation: palette-cycle 7s linear infinite;
    animation-delay: calc(var(--delay-step) * -0.12s);
    aspect-ratio: 1;
  }

  .contribution-level-0 {
    opacity: 0.12;
  }

  .contribution-level-1 {
    opacity: 0.35;
  }

  .contribution-level-2 {
    opacity: 0.55;
  }

  .contribution-level-3 {
    opacity: 0.8;
  }

  @keyframes palette-cycle {
    0% {
      background: #fff;
    }

    8% {
      background: var(--ctp-mocha-flamingo);
    }

    15% {
      background: var(--ctp-mocha-pink);
    }

    23% {
      background: var(--ctp-mocha-mauve);
    }

    31% {
      background: var(--ctp-mocha-red);
    }

    38% {
      background: var(--ctp-mocha-maroon);
    }

    46% {
      background: var(--ctp-mocha-peach);
    }

    54% {
      background: var(--ctp-mocha-yellow);
    }

    62% {
      background: var(--ctp-mocha-green);
    }

    69% {
      background: var(--ctp-mocha-teal);
    }

    77% {
      background: var(--ctp-mocha-sky);
    }

    85% {
      background: var(--ctp-mocha-sapphire);
    }

    92% {
      background: var(--ctp-mocha-blue);
    }

    100% {
      background: var(--ctp-mocha-lavender);
    }
  }

  .github-repos {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
  }

  .github-repos a {
    background: var(--base);
    color: var(--text);
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px 12px;
    text-decoration: none;
  }

  .github-repos b {
    transition: color 0.25s;
  }

  .github-repos a:hover b {
    color: var(--pink);
  }

  .github-repos .sub {
    font-size: 13px;
    margin-top: 4px;
  }

  .repo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: auto;
    padding-top: 8px;
  }

  .repo-stats span {
    align-items: center;
    display: inline-flex;
    gap: 5px;
  }

  .repo-stats i {
    background: var(--lang-color);
    border-radius: 50%;
    height: 10px;
    width: 10px;
  }

  .repo-stats svg {
    fill: currentColor;
    height: 14px;
    width: 14px;
  }

  @media (max-width: 600px) {
    .github-repos {
      grid-template-columns: 1fr;
    }
  }
</style>
