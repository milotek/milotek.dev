---
import {Image} from 'astro:assets';

import selfiePhoto from '../assets/me/selfie.jpg';
import alternatePhoto from '../assets/me/swap.jpg';
import {SITE} from '../config';
import {useTranslations} from '../i18n';
import {url} from '../lib/url';

const t = useTranslations(Astro.currentLocale);
const currentPath = Astro.url.pathname;

const navLinks = [
  {href: url(''), text: t('nav.home')},
  {href: url('about/'), text: t('nav.about')},
  {href: url('projects/'), text: t('nav.projects')},
  {href: url('blog/'), text: t('nav.blog')},
  {href: url('art/'), text: t('nav.art')},
  {href: `mailto:${SITE.email}`, text: t('nav.contact')},
];

function isCurrentRoute(href: string): boolean {
  if (href === url('')) {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
}
---

<header class="hero">
  <div class="hero-banner card">
    <Image
      class="hero-photo"
      src={selfiePhoto}
      alt=""
      widths={[800, 1600]}
      sizes="(max-width: 1152px) 100vw, 1120px"
      loading="eager"
    />
    <Image
      class="hero-photo hero-photo-stretched"
      src={alternatePhoto}
      alt=""
      width={100}
      quality={30}
      loading="eager"
      hidden
    />
    <nav class="hero-nav" aria-label={t('nav.label')}>
      {
        navLinks.map((item) => (
          <a
            class="chip"
            href={item.href}
            aria-current={isCurrentRoute(item.href) ? 'page' : undefined}
          >
            {item.text}
          </a>
        ))
      }
    </nav>
    <p class="hero-brand">{t('hero.brand')}</p>
  </div>
  <div class="hero-rainbow"></div>
  <div class="hero-strip">
    <p class="hero-copyright">{t('hero.copyright')}</p>
    <div class="hero-controls">
      <button
        class="button"
        type="button"
        data-action="aaaa"
        aria-pressed="false"
        aria-label={t('hero.aaaa')}
      >
        a
      </button>
      <button
        class="button"
        type="button"
        data-action="flip"
        aria-pressed="false"
        aria-label={t('hero.flip')}
      >
        b
      </button>
      <button
        class="button"
        type="button"
        data-action="swap"
        aria-pressed="false"
        aria-label={t('hero.swap')}
      >
        c
      </button>
    </div>
  </div>
</header>

<script>
  import {initHeroControls} from '../scripts/hero_controls';

  initHeroControls();
</script>

<style>
  .hero {
    transition: transform 0.3s;
  }

  .hero.flipped {
    transform: scaleX(-1);
  }

  .hero-banner {
    background: var(--mantle);
    height: 420px;
    overflow: hidden;
    position: relative;
  }

  .hero-photo {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center 30%;
    position: absolute;
    width: 100%;
  }

  .hero-photo[hidden] {
    display: none;
  }

  .hero-photo-stretched {
    object-fit: fill;
  }

  .hero-nav {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    font-size: 24px;
    gap: 18px;
    left: 40px;
    position: absolute;
    top: 40px;
  }

  .hero-brand {
    background: var(--base);
    bottom: 20px;
    color: var(--pink);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.25;
    padding: 0 12px;
    position: absolute;
    right: 20px;
  }

  .hero-rainbow {
    animation: rainbow 3s linear infinite;
    background: var(--rainbow);
    height: 10px;
  }

  .hero-strip {
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
  }

  .hero-copyright {
    align-items: center;
    background: var(--mantle);
    color: #a6adc880;
    display: flex;
    font-size: 14px;
    font-weight: 700;
    height: 40px;
    padding: 0 12px;
  }

  .hero-controls {
    display: flex;
  }

  /* Keep specificity low so `.button:hover` and `[aria-pressed='true']` win. */
  button {
    background: var(--mantle);
    font-size: 20px;
    height: 40px;
    width: 40px;
  }

  @media (max-width: 600px) {
    .hero-banner {
      height: 360px;
    }

    .hero-nav {
      left: 20px;
      top: 20px;
    }

    .hero-brand {
      font-size: 30px;
    }
  }
</style>
