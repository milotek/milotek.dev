---
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import selfie from '../assets/me/selfie.jpg';
import swap from '../assets/me/swap.jpg';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const here = Astro.url.pathname;

const nav = [
  { href: url(''), text: '/' },
  { href: url('projects/'), text: '/projects' },
  { href: url('blog/'), text: '/blog' },
  { href: url('art/'), text: '/art' },
  { href: `${url('')}#contact`, text: '/contact' },
];

function current(href: string) {
  if (href.includes('#')) return false;
  return href === url('') ? here === href : here.startsWith(href);
}
---

<header class:list={['hero', { compact }]}>
  <div class="card">
    <Image class="photo" src={selfie} alt="" widths={[800, 1600]} sizes="(max-width: 1152px) 100vw, 1120px" loading="eager" />
    <Image class="photo" src={swap} alt="" widths={[800, 1600]} sizes="(max-width: 1152px) 100vw, 1120px" hidden />
    <nav aria-label="Site">
      {nav.map((n) => <a class="chip" href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.text}</a>)}
    </nav>
    <p class="brand">milo tek's site</p>
  </div>
  <div class="rainbow"></div>
  <div class="strip">
    <p class="copy">COPYRIGHT LOLOLOLOL</p>
    <div class="buttons">
      <button type="button" data-action="sound" aria-pressed="false" aria-label="Music">a</button>
      <button type="button" data-action="flip" aria-pressed="false" aria-label="Flip the card">b</button>
      <button type="button" data-action="swap" aria-pressed="false" aria-label="Swap the picture">c</button>
    </div>
  </div>
  <audio class="music" src={url('audio/music.mp3')} loop preload="none"></audio>
</header>

<script>
  import { url } from '../lib/url';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const card = hero.querySelector<HTMLElement>('.card')!;
  const [selfie, swapped] = hero.querySelectorAll<HTMLImageElement>('.photo');
  const music = hero.querySelector<HTMLAudioElement>('.music')!;
  const buttons = [...hero.querySelectorAll<HTMLButtonElement>('.buttons button')];
  const button = (action: string) => buttons.find((b) => b.dataset.action === action)!;

  const hover = new Audio(url('audio/hover.wav'));
  const click = new Audio(url('audio/click.wav'));
  let soundOn = false;
  let analyser: AnalyserNode | undefined;
  let frame = 0;

  function play(sound: HTMLAudioElement) {
    if (!soundOn) return;
    sound.currentTime = 0;
    sound.play().catch(() => {});
  }

  function remember(key: string, on: boolean) {
    try {
      localStorage.setItem(`hero:${key}`, on ? '1' : '0');
    } catch {}
  }

  function recall(key: string) {
    try {
      return localStorage.getItem(`hero:${key}`) === '1';
    } catch {
      return false;
    }
  }

  function setPressed(action: string, on: boolean) {
    button(action).setAttribute('aria-pressed', String(on));
  }

  function setFlip(on: boolean) {
    card.classList.toggle('flipped', on);
    setPressed('flip', on);
    remember('flip', on);
  }

  function setSwap(on: boolean) {
    selfie!.hidden = on;
    swapped!.hidden = !on;
    setPressed('swap', on);
    remember('swap', on);
  }

  function bounce() {
    const bins = new Uint8Array(analyser!.frequencyBinCount);
    analyser!.getByteFrequencyData(bins);
    const band = Math.floor(bins.length / buttons.length);
    buttons.forEach((b, i) => {
      let sum = 0;
      for (let j = i * band; j < (i + 1) * band; j++) sum += bins[j]!;
      b.style.transform = `scaleY(${1 + (sum / band / 255) * 3})`;
    });
    frame = requestAnimationFrame(bounce);
  }

  function setSound(on: boolean) {
    soundOn = on;
    setPressed('sound', on);
    if (!on) {
      music.pause();
      cancelAnimationFrame(frame);
      buttons.forEach((b) => (b.style.transform = ''));
      return;
    }
    if (!analyser) {
      const ctx = new AudioContext();
      analyser = ctx.createAnalyser();
      analyser.fftSize = 256;
      ctx.createMediaElementSource(music).connect(analyser);
      analyser.connect(ctx.destination);
    }
    music.play().catch(() => setSound(false));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) bounce();
  }

  button('sound').addEventListener('click', () => setSound(!soundOn));
  button('flip').addEventListener('click', () => setFlip(!card.classList.contains('flipped')));
  button('swap').addEventListener('click', () => setSwap(selfie!.hidden === false));

  document.querySelectorAll<HTMLElement>('.hero a, .hero button').forEach((el) => {
    el.addEventListener('mouseenter', () => play(hover));
    el.addEventListener('click', () => play(click));
  });

  setFlip(recall('flip'));
  setSwap(recall('swap'));
</script>

<style>
  .card {
    position: relative;
    height: 420px;
    overflow: hidden;
    background: var(--mantle);
    transition: transform 0.3s;
  }
  .card.flipped { transform: scaleX(-1); }
  .compact .card { height: 220px; }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .photo[hidden] { display: none; }
  nav {
    position: absolute;
    top: 40px;
    left: 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    font-size: 24px;
  }
  .compact nav {
    top: 24px;
    left: 24px;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 20px;
  }
  .brand {
    position: absolute;
    right: 20px;
    bottom: 20px;
    padding: 0 12px;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pink);
    background: var(--base);
  }
  .compact .brand { font-size: 32px; }
  .rainbow {
    height: 10px;
    background: linear-gradient(90deg, #f5c2e7, #eba0ac, #fab387, #f9e2af, #a6e3a1, #94e2d5, #89dceb, #74c7ec, #89b4fa, #b4befe, #f5c2e7);
    background-size: 200% 100%;
    animation: rainbow 3s linear infinite;
  }
  @keyframes rainbow {
    to { background-position: 200% 0; }
  }
  .strip {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .copy {
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 14px;
    font-weight: 700;
    color: #a6adc880;
    background: var(--mantle);
  }
  .buttons { display: flex; }
  button {
    width: 40px;
    height: 40px;
    border: 0;
    font: 700 20px var(--font-sans);
    color: var(--pink);
    background: var(--mantle);
    cursor: pointer;
    transform-origin: top center;
    transition: background-color 0.25s, color 0.25s;
  }
  button:hover, button[aria-pressed='true'] { color: var(--base); background: var(--pink); }
  @media (max-width: 600px) {
    .card { height: 360px; }
    nav { top: 20px; left: 20px; }
    .brand { font-size: 30px; }
    .compact .card { height: 200px; }
    .compact nav { font-size: 17px; gap: 8px; }
    .compact .brand { font-size: 24px; }
  }
</style>
