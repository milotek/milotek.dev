---
interface Props {
  label: string;
  span?: 4 | 5 | 7 | 8 | 12;
  action?: {
    href: string;
    text: string;
  };
  id?: string;
}

const {label, span = 12, action, id} = Astro.props;
---

<section class:list={['tile', `span-${span}`]} id={id} aria-label={label}>
  <span class="chip tile-tab">{label}</span>
  {
    action && (
      <a class="tile-action mono" href={action.href}>
        {action.text}
      </a>
    )
  }
  <slot />
</section>

<style>
  .tile {
    backdrop-filter: blur(2px);
    background: rgb(24 24 37 / 0.9);
    min-width: 0;
    padding: 30px 22px 22px;
    position: relative;
    scroll-margin-top: 32px;
  }

  .tile-tab {
    font-size: 18px;
    left: 16px;
    position: absolute;
    top: -14px;
  }

  .tile-action {
    color: var(--dim);
    position: absolute;
    right: 22px;
    text-decoration: none;
    top: 10px;
  }

  .tile-action:hover {
    color: var(--pink);
  }
</style>
