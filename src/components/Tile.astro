---
interface Props {
  label: string;
  span?: 4 | 5 | 7 | 8 | 12;
  action?: { href: string; text: string };
  id?: string;
}

const { label, span = 12, action, id } = Astro.props;
---

<section class:list={['tile', `span-${span}`]} id={id} aria-label={label}>
  <span class="chip tab">{label}</span>
  {action && <a class="action mono" href={action.href}>{action.text}</a>}
  <slot />
</section>

<style>
  .tile {
    position: relative;
    min-width: 0;
    padding: 30px 22px 22px;
    background: rgb(24 24 37 / 0.9);
    backdrop-filter: blur(2px);
    scroll-margin-top: 32px;
  }
  .tab {
    position: absolute;
    top: -14px;
    left: 16px;
    font-size: 18px;
  }
  .action {
    position: absolute;
    top: 10px;
    right: 14px;
    color: var(--dim);
    text-decoration: none;
  }
  .action:hover { color: var(--pink); }
</style>
