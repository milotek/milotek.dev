---
import { marquee } from '../data/marquee';
---

<div class="marquee" aria-hidden="true">
  {
    marquee.map((line) => (
      <div class="row">
        <div class="track" style={`--chars: ${line.length}`}>
          <span>{line}</span>
          <span>{line}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .marquee {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    pointer-events: none;
    user-select: none;
  }
  .row {
    white-space: nowrap;
    font: 700 120px/1 var(--font-wide);
    color: #18182580;
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll calc(var(--chars) * 2s) linear infinite;
  }
  .row:nth-child(even) .track { animation-direction: reverse; }
  span { padding-right: 1em; }
  @keyframes scroll {
    to { transform: translateX(-50%); }
  }
  @media (max-width: 600px) {
    .row { font-size: 72px; }
  }
</style>
