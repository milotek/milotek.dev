---
import {MARQUEE_LINES} from '../data/marquee';
---

<div class="marquee" aria-hidden="true">
  {
    MARQUEE_LINES.map((line) => (
      <div class="marquee-row">
        <div class="marquee-track" style={`--chars: ${line.length}`}>
          <span>{line}</span>
          <span>{line}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .marquee {
    display: flex;
    flex-direction: column;
    inset: 0;
    justify-content: space-evenly;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    user-select: none;
    z-index: 0;
  }

  .marquee-row {
    color: #18182580;
    font: 700 120px/1 var(--font-wide);
    white-space: nowrap;
  }

  .marquee-track {
    animation: marquee-scroll calc(var(--chars) * 2s) linear infinite;
    display: flex;
    width: max-content;
  }

  .marquee-row:nth-child(even) .marquee-track {
    animation-direction: reverse;
  }

  .marquee-track span {
    padding-right: 1em;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 600px) {
    .marquee-row {
      font-size: 72px;
    }
  }
</style>
