---
import { friends, site } from '../config';
import { useTranslations } from '../i18n';
import { url } from '../lib/url';

const t = useTranslations(Astro.currentLocale);
const own = new URL(url('88x31.png'), Astro.site).href;
const snippet = `<a href="${new URL(url(''), Astro.site).href}"><img src="${own}" alt="${site.handle}" width="88" height="31"></a>`;
---

<ul class="wall">
  {
    friends.map((f) => (
      <li>
        <a href={f.href} title={f.name}>
          <img src={f.button} alt={f.name} width="88" height="31" loading="lazy" decoding="async" />
        </a>
      </li>
    ))
  }
</ul>
<div class="mine">
  <img src={url('88x31.png')} alt={t('buttons.mine', { handle: site.handle })} width="88" height="31" />
  <button type="button" data-snippet={snippet} data-copied={t('buttons.copied')} data-failed={t('buttons.failed')}>{t('buttons.copy')}</button>
</div>
<script is:inline src="https://pawr.ing/webring/webring.js" defer></script>
<div id="pawring"></div>

<script>
  const button = document.querySelector<HTMLButtonElement>('.mine button')!;
  const label = button.textContent;
  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.snippet!);
      button.textContent = button.dataset.copied!;
    } catch {
      button.textContent = button.dataset.failed!;
    }
    setTimeout(() => (button.textContent = label), 1500);
  });
</script>

<style>
  .wall { display: flex; flex-wrap: wrap; gap: 6px; }
  img { image-rendering: pixelated; }
  .wall img { transition: transform 0.15s; }
  .wall a:hover img { transform: scale(1.4); }
  .mine {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  button {
    border: 0;
    padding: 4px 10px;
    font: 700 13px var(--font-sans);
    color: var(--base);
    background: var(--pink);
    cursor: pointer;
  }
  #pawring { margin-top: 14px; }
</style>
