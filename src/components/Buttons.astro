---
import {WEB_BUTTONS, type WebButton} from '../config';
import {url} from '../lib/url';

const LANE_COUNT = 3;
const LANE_DURATIONS_SEC: readonly number[] = [7.5, 5.5, 9];
const WOBBLE_WAVES = 2;
const WOBBLE_PERIOD_SEC = 1.6;

const lanes: WebButton[][] = Array.from({length: LANE_COUNT}, (_, laneIndex) =>
  WEB_BUTTONS.filter((_, buttonIndex) => buttonIndex % LANE_COUNT === laneIndex),
);

function resolvePath(path: string): string {
  return path.startsWith('/') ? url(path.slice(1)) : path;
}

function computeWobbleDelay(
  itemIndex: number,
  laneLength: number,
  laneIndex: number,
): string {
  const phase = ((itemIndex % laneLength) / laneLength) * WOBBLE_WAVES;
  const delaySec = -((phase + laneIndex / 2) * WOBBLE_PERIOD_SEC);
  return `${delaySec.toFixed(2)}s`;
}
---

<div class="button-waterfall">
  {
    lanes.map((lane, laneIndex) => (
      <ul
        class="button-lane"
        style={`--duration: ${LANE_DURATIONS_SEC[laneIndex] ?? 7}s`}
      >
        {[...lane, ...lane].map((button, itemIndex) => {
          const Tag = button.href ? 'a' : 'span';
          return (
            <li>
              <Tag
                class="web-button-badge"
                style={`animation-delay: ${computeWobbleDelay(itemIndex, lane.length, laneIndex)}`}
                href={button.href ? resolvePath(button.href) : undefined}
                title={button.name}
              >
                <img
                  src={resolvePath(button.imageSrc)}
                  alt={button.name}
                  width="88"
                  height="31"
                  loading="lazy"
                  decoding="async"
                />
              </Tag>
            </li>
          );
        })}
      </ul>
    ))
  }
</div>
<script is:inline src="https://pawr.ing/webring/webring.js" defer></script>
<hr class="webring-divider" />
<div id="pawring"></div>

<style>
  .button-waterfall {
    display: flex;
    gap: 8px;
    height: 160px;
    justify-content: center;
    mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent);
    overflow: hidden;
  }

  .button-lane {
    animation: waterfall-scroll var(--duration) linear infinite;
    height: max-content;
  }

  .button-lane:hover,
  .button-lane:hover .web-button-badge {
    animation-play-state: paused;
  }

  .button-lane li {
    padding-bottom: 6px;
  }

  .web-button-badge {
    animation: button-wobble 1.6s ease-in-out infinite;
    display: block;
  }

  img {
    image-rendering: pixelated;
  }

  .button-lane img {
    transition: transform 0.15s;
  }

  .web-button-badge:hover img {
    transform: scale(1.4);
  }

  .button-lane:hover,
  .web-button-badge:hover {
    position: relative;
    z-index: 1;
  }

  @keyframes waterfall-scroll {
    from {
      transform: translateY(-50%);
    }

    to {
      transform: translateY(0);
    }
  }

  @keyframes button-wobble {
    0%,
    100% {
      transform: translateX(-3px);
    }

    50% {
      transform: translateX(3px);
    }
  }

  #pawring {
    display: flex;
    margin-inline: auto;
    width: fit-content;
  }

  .webring-divider {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 14px 0;
  }
</style>
