---
import {SITE} from '../config';
import {useTranslations} from '../i18n';

const t = useTranslations(Astro.currentLocale);
const {user, apiKey} = SITE.lastfm;
const isConfigured = Boolean(user && apiKey);

const WAVEFORM_GRADIENT_TOKENS = [
  'rosewater',
  'flamingo',
  'pink',
  'mauve',
  'red',
  'maroon',
  'peach',
  'yellow',
  'green',
  'teal',
  'sky',
  'sapphire',
  'blue',
  'lavender',
] as const;

const PLACEHOLDER_ROW_COUNT = 5;

const widgetStrings = {
  live: t('nowPlaying.live'),
  ago: t('nowPlaying.ago'),
  units: t('nowPlaying.units'),
  play: t('nowPlaying.play'),
  pause: t('nowPlaying.pause'),
  broke: t('error.broke', {what: 'last.fm'}),
};
---

{
  isConfigured ? (
    <>
      <div
        class="now-playing"
        data-user={user}
        data-key={apiKey}
        data-strings={JSON.stringify(widgetStrings)}
      >
        <a class="album-art" aria-hidden="true" tabindex="-1" />
        <div class="track-meta">
          <p class="track-title wide">
            <span class="placeholder-text">{t('nowPlaying.title')}</span>
          </p>
          <p class="track-artist sub">
            <span class="placeholder-text">{t('nowPlaying.artist')}</span>
          </p>
          <div class="audio-player" data-state="idle">
            <button
              class="play-button button"
              type="button"
              aria-label={t('nowPlaying.play')}
              disabled
            >
              <svg
                class="icon-play"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
              <svg
                class="icon-pause"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M6 5h4v14H6zm8 0h4v14h-4z" />
              </svg>
            </button>
            <svg
              class="waveform"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <linearGradient id="waveform-fill">
                {WAVEFORM_GRADIENT_TOKENS.map((token, index) => (
                  <stop
                    offset={index / (WAVEFORM_GRADIENT_TOKENS.length - 1)}
                    style={`stop-color: var(--ctp-mocha-${token})`}
                  />
                ))}
              </linearGradient>
              <path class="waveform-base" />
              <path class="waveform-hover" />
              <path class="waveform-played" />
              <path class="waveform-flash" />
            </svg>
            <span class="track-time mono">
              <span class="time-current">0:00</span>
              <span class="time-total dim">0:00</span>
            </span>
          </div>
        </div>
      </div>

      <hr class="recent-divider" />

      <ul class="recent-tracks scroller mono dim">
        {Array.from({length: PLACEHOLDER_ROW_COUNT}, () => (
          <li class="placeholder-text">
            {t('nowPlaying.title')} - {t('nowPlaying.artist')}{' '}
            {t('nowPlaying.time')}
          </li>
        ))}
      </ul>

      <audio class="track-audio" crossorigin="anonymous" preload="none" />
    </>
  ) : (
    <div class="now-playing">
      <p class="error-banner">
        <span>
          <span>{widgetStrings.broke}</span>
        </span>
      </p>
    </div>
  )
}

<script>
  import {initNowPlayingWidgets} from '../scripts/now_playing';

  initNowPlayingWidgets();
</script>

<style>
  .now-playing {
    display: flex;
    gap: 18px;
  }

  .album-art {
    background: conic-gradient(
        from 200deg,
        var(--ctp-mocha-pink),
        var(--blue),
        var(--green),
        var(--ctp-mocha-yellow),
        var(--ctp-mocha-pink)
      )
      center / cover;
    flex: none;
    height: 150px;
    width: 150px;
  }

  .track-meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .track-title {
    font-size: 28px;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track-title :global(a) {
    color: var(--text);
    text-decoration: none;
  }

  .track-title :global(a:hover) {
    color: var(--pink);
  }

  .track-artist {
    margin-top: 6px;
  }

  .placeholder-text {
    color: var(--dim);
  }

  .audio-player {
    align-items: center;
    display: flex;
    gap: 10px;
    margin-top: auto;
  }

  .play-button {
    display: grid;
    flex: none;
    height: 30px;
    place-items: center;
    width: 30px;
  }

  .play-button svg {
    fill: currentColor;
    height: 20px;
    width: 20px;
  }

  .icon-pause,
  [data-state='playing'] .icon-play,
  [data-state='loading'] .icon-play {
    display: none;
  }

  [data-state='playing'] .icon-pause,
  [data-state='loading'] .icon-pause {
    display: block;
  }

  .waveform {
    --hover: 0;
    --progress: 0;
    cursor: pointer;
    flex: 1;
    height: 26px;
  }

  .waveform-base {
    fill: color-mix(in srgb, var(--text) 22%, transparent);
  }

  .waveform-hover {
    clip-path: inset(0 calc((1 - var(--hover)) * 100%) 0 0);
    fill: color-mix(in srgb, var(--text) 45%, transparent);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .waveform:hover .waveform-hover {
    opacity: 1;
  }

  .waveform-flash {
    fill: #fff;
    opacity: var(--flash, 0);
  }

  .waveform-played {
    clip-path: inset(0 calc((1 - var(--progress)) * 100%) 0 0);
    fill: url(#waveform-fill);
  }

  .track-time {
    align-items: flex-end;
    color: var(--sub);
    display: flex;
    flex: none;
    flex-direction: column;
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
    min-width: 4ch;
  }

  .recent-divider {
    border: 0;
    border-top: 1px solid var(--line);
    flex: none;
    margin: 14px 0 0;
  }

  .recent-tracks {
    --fade: 32px;
    flex: 1;
    margin-right: -10px;
    min-height: 0;
    overflow-y: auto;
    padding-right: 12px;
  }

  .recent-tracks:not(:empty) {
    margin-top: 8px;
    padding-top: 6px;
  }

  .recent-tracks :global(button) {
    background: none;
    border: 0;
    color: var(--sub);
    cursor: pointer;
    display: block;
    font: inherit;
    max-width: 100%;
    overflow: hidden;
    padding: 0;
    text-align: left;
    text-overflow: ellipsis;
    transition: color 0.25s;
    white-space: nowrap;
  }

  .recent-tracks :global(button:hover) {
    color: var(--pink);
  }

  .recent-tracks :global(.is-selected) {
    color: var(--text);
  }

  @media (min-width: 901px) {
    :global(.tile:has(.now-playing)) {
      contain: size;
      display: flex;
      flex-direction: column;
    }
  }

  @media (max-width: 900px) {
    .recent-tracks {
      max-height: 64px;
    }
  }

  @media (max-width: 600px) {
    .now-playing {
      flex-direction: column;
    }

    .album-art {
      height: 160px;
      width: 100%;
    }
  }
</style>
